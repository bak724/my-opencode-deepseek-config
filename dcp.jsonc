{
  "$schema": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/master/dcp.schema.json",
  "enabled": true,
  "autoUpdate": true,
  "debug": false,

  // Reduce notification noise: show compression summary only, no inline expansion
  "pruneNotification": "minimal",
  "pruneNotificationType": "toast",

  // Manual mode off: allow the model to decide when to compress (vs. waiting for /dcp command)
  "manualMode": {
    "enabled": false,
    "automaticStrategies": true
  },

  // Turn protection: on (preserve N most recent turns from pruning)
  "turnProtection": {
    "enabled": true,
    "turns": 4
  },

  "commands": {
    "enabled": true,
    "protectedTools": []
  },

  "experimental": {
    // Disable DCP for subagent sessions (short-lived; orchestrator manages upper-level context)
    "allowSubAgents": false,
    "customPrompts": false
  },

  // 受保护文件模式：不裁剪这些文件的操作
  "protectedFilePatterns": [
    "**/opencode.json",
    "**/opencode.jsonc",
    "**/AGENTS.md",
    "**/*.env*",
    "**/.opencode/**"
  ],

  // ══════════════════════════════════════════════════════════════
  // Compression strategy — tuned for DeepSeek V4 (128K context)
  // Core principle: proactive compression > passive overflow; DCP manages context, not native compaction
  // ══════════════════════════════════════════════════════════════
  "compress": {
    // range 模式：将连续对话范围压缩为高保真摘要
    "mode": "range",
    "permission": "allow",
    "showCompression": true,
    // 摘要缓冲：压缩摘要 token 不计入 maxContextLimit，充分利用窗口
    "summaryBuffer": true,

    // 上下文阈值（DeepSeek V4 128K 窗口调优）：
    // 75K 开始强力推压缩（留 53K 缓冲供新内容 + 摘要）
    "maxContextLimit": 75000,
    // 35K 开始温和提醒模型可压缩（提前感知上下文压力）
    "minContextLimit": 35000,

    // 每 3 次 LLM 请求提醒一次压缩（比默认 5 更频繁，适配 token 效率目标）
    "nudgeFrequency": 3,
    // 从用户消息后第 12 条消息开始注入压缩提醒（比默认 15 更早）
    "iterationNudgeThreshold": 12,
    // 强力推：模型被明确要求优先考虑压缩
    "nudgeForce": "strong",

    // 压缩时保留以下工具的输出（避免关键信息丢失）
    "protectedTools": [
      "task",
      "skill",
      "todowrite",
      "todoread"
    ],

    // <protect> 标签（关闭，我们暂无此使用模式）
    "protectTags": false,
    // 保护用户消息（关闭：允许压缩大型日志粘贴等场景）
    "protectUserMessages": true
  },

  // 自动裁剪策略
  "strategies": {
    // 重复工具调用去重：相同 tool+args 只保留最新输出
    "deduplication": {
      "enabled": true,
      "protectedTools": [
        "task",
        "skill",
        "todowrite",
        "todoread"
      ]
    },
    // 错误工具输入裁剪：3 轮后移除错误工具调用的输入体（保留错误信息）
    "purgeErrors": {
      "enabled": true,
      "turns": 3,
      "protectedTools": [
        "task",
        "skill",
        "todowrite",
        "todoread"
      ]
    }
  }
}
